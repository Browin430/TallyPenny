<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/voice_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/voice_widget_background"
    android:clickable="true"
    android:contentDescription="@string/voice_widget_description"
    android:padding="5dp">

    <ImageView
        android:id="@+id/voice_widget_character"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:padding="3dp"
        android:contentDescription="@string/voice_widget_character"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_jigglypuff" />

    <ImageView
        android:id="@+id/voice_widget_mic"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/voice_widget_mic_background"
        android:clickable="true"
        android:contentDescription="@string/voice_widget_open"
        android:padding="11dp"
        android:rotation="-20"
        android:src="@drawable/voice_widget_mic_icon" />

</FrameLayout>
