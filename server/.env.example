# 阿里云 DashScope（通义千问）API Key，https://bailian.console.aliyun.com/ 开通
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 公网业务接口访问令牌（至少 24 个随机字符；App 构建时通过 FM_API_TOKEN 注入）
FM_API_TOKEN=replace_with_a_long_random_token

# 可选：自定义 DashScope 兼容端点
# DASHSCOPE_BASE_URL=

# 可选：模型覆盖
# QWEN_TEXT_MODEL=qwen-plus
# VL 默认 qwen-vl-plus（qwen-vl-max-latest 部分账号未开通会 Access denied）
# QWEN_VL_MODEL=qwen-vl-plus
# QWEN_ASR_MODEL=qwen3-asr-flash

# 服务端口
# FM_SERVER_PORT=8765
